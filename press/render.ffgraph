[0:v]drawbox=x=480:y=735:w=120:h=10:color=white@0.9:t=fill,drawtext=fontfile=press/fonts/DejaVuSans-Bold.ttf:textfile=press/scene-1.txt:fontcolor=white:fontsize=98:line_spacing=20:x=(w-text_w)/2:y=(h-text_h)/2+125[s1];
[1:v]drawbox=x=480:y=735:w=120:h=10:color=white@0.9:t=fill,drawtext=fontfile=press/fonts/DejaVuSans-Bold.ttf:textfile=press/scene-2.txt:fontcolor=white:fontsize=82:line_spacing=18:x=(w-text_w)/2:y=(h-text_h)/2+125[s2];
[2:v]drawbox=x=480:y=735:w=120:h=10:color=white@0.9:t=fill,drawtext=fontfile=press/fonts/DejaVuSans-Bold.ttf:textfile=press/scene-3.txt:fontcolor=white:fontsize=88:line_spacing=18:x=(w-text_w)/2:y=(h-text_h)/2+125[s3];
[3:v]drawbox=x=480:y=735:w=120:h=10:color=white@0.9:t=fill,drawtext=fontfile=press/fonts/DejaVuSans-Bold.ttf:textfile=press/scene-4.txt:fontcolor=white:fontsize=100:line_spacing=20:x=(w-text_w)/2:y=(h-text_h)/2+125[s4];
[4:v]null[mag];
[s1][s2][s3][s4][mag]concat=n=5:v=1:a=0[base];
[base]split[clear][softsrc];
[softsrc]format=yuva420p,gblur=sigma=28,eq=saturation=0.35,fade=t=in:st=17.5:d=0.8:alpha=1[soft];
[clear][soft]overlay=shortest=1:format=auto[softened];
[softened][5:v]overlay=shortest=1:format=auto:enable='lt(t,17.5)'[badged];
[6:v]fps=30,setpts=PTS-STARTPTS+17.5/TB,format=yuva420p[card];
[badged][card]overlay=shortest=1:eof_action=pass:format=auto:enable='gte(t,17.5)'[composite];
